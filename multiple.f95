program multiply
implicit none 

integer :: first_number = 0
integer :: second_number = 0 
integer :: counter = 0 
integer :: buffer = 0
integer :: bufer_two = 0 


read *, first_number
read *, second_number

    do counter = bufer_two, second_number
    
        buffer = buffer + first_number
    
    end do

buffer = buffer - first_number

print *, buffer

end program multiply
